{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "**/.env", "**/.env.local"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "WEB_PORT",
    "NEXT_PUBLIC_WEB_URL",
    "PANSOU_URL",
    "PANSOU_TIMEOUT_MS",
    "PANSOU_CHANNELS",
    "PANSOU_PLUGINS",
    "PANSOU_CACHE_TTL_MS",
    "SHARE_CHECK_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
