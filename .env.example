# 项目段 NN=35（本机与其他项目错开，勿改成 3000/5432）
NN=35
API_PORT=3500
WEB_PORT=3501
ADMIN_PORT=3502
POSTGRES_HOST_PORT=3532
REDIS_HOST_PORT=3537
S3_HOST_PORT=3590
S3_CONSOLE_PORT=3591
PANSOU_HOST_PORT=3588
PANSOU_URL=http://127.0.0.1:3588
PANSOU_TIMEOUT_MS=10000
PANSOU_CACHE_TTL_MS=60000
# 丢掉公开页写明「已失效」的分享。超时/被墙不当死链，避免误伤
SHARE_CHECK_ENABLED=true
SHARE_CHECK_TIMEOUT_MS=2000
SHARE_CHECK_CONCURRENCY=6
SHARE_CHECK_BUDGET_MS=2500
SHARE_DEAD_TTL_MS=604800000
SHARE_SKIP_TTL_MS=1800000
# 覆盖上游默认频道 / 插件。空 = 用 compose 里 pansou.env
PANSOU_CHANNELS=
PANSOU_PLUGINS=

POSTGRES_USER=sister-netdisk
POSTGRES_PASSWORD=sister-netdisk_dev
POSTGRES_DB=sister-netdisk_dev
DATABASE_URL=postgresql://sister-netdisk:sister-netdisk_dev@localhost:3532/sister-netdisk_dev

API_INTERNAL_URL=http://localhost:3500
CORS_ORIGINS=http://localhost:3501,http://localhost:3502
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-chars
BETTER_AUTH_URL=http://localhost:3500
SWAGGER=1

WEB_URL=http://localhost:3501
ADMIN_URL=http://localhost:3502
NEXT_PUBLIC_WEB_URL=http://localhost:3501
NEXT_PUBLIC_ADMIN_URL=http://localhost:3502
NEXT_PUBLIC_API_URL=http://localhost:3501/api
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3502/api

# 本地 RustFS；应用只认下面这组 S3 变量。生产改成阿里云 OSS。
S3_BUCKET=sister-netdisk-dev
S3_ENDPOINT=http://localhost:3590
S3_ACCESS_KEY_ID=rustfsadmin
S3_ACCESS_KEY_SECRET=rustfsadmin
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=http://localhost:3590/sister-netdisk-dev

# 仅本地。pnpm db:seed 写入员工 + 会员；生产不要设、也不要跑 seed
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=password
DEV_ADMIN_NAME=本地管理员
DEV_USER_EMAIL=user@example.com
DEV_USER_PASSWORD=password
DEV_USER_NAME=本地会员
