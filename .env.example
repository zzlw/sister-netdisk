# 项目段 NN=35（本机与其他项目错开，勿改成 3000/5432）
NN=35
WEB_PORT=3501
PANSOU_HOST_PORT=3588
PANSOU_URL=http://127.0.0.1:3588
PANSOU_TIMEOUT_MS=30000
PANSOU_CACHE_TTL_MS=60000
# 丢掉公开页写明「已失效」的分享。海外探国内死链不准，默认关
SHARE_CHECK_ENABLED=false
SHARE_CHECK_TIMEOUT_MS=2000
SHARE_CHECK_CONCURRENCY=6
SHARE_CHECK_BUDGET_MS=2500
SHARE_DEAD_TTL_MS=604800000
SHARE_SKIP_TTL_MS=1800000
# 覆盖上游默认频道 / 插件。空 = 用 compose 里 pansou.env
PANSOU_CHANNELS=
PANSOU_PLUGINS=

NEXT_PUBLIC_WEB_URL=http://localhost:3501

# 本地 RustFS；应用只认下面这组 S3 变量。生产改成阿里云 OSS。
S3_HOST_PORT=3590
S3_CONSOLE_PORT=3591
S3_BUCKET=sister-netdisk-dev
S3_ENDPOINT=http://localhost:3590
S3_ACCESS_KEY_ID=rustfsadmin
S3_ACCESS_KEY_SECRET=rustfsadmin
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=http://localhost:3590/sister-netdisk-dev
