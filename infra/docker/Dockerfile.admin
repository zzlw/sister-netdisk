FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY apps/admin/package.json apps/admin/package.json
RUN pnpm install --frozen-lockfile --filter @repo/shared --filter @repo/ui --filter @repo/admin...

FROM deps AS build
ARG API_INTERNAL_URL=http://api:3000
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_ADMIN_API_URL=/api
ENV API_INTERNAL_URL=$API_INTERNAL_URL
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
ENV NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL
COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/admin apps/admin
RUN pnpm --filter @repo/shared --filter @repo/admin build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public ./apps/admin/public
EXPOSE 3000
CMD ["node", "apps/admin/server.js"]
