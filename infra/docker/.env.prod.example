# 复制为服务器 /opt/sister-netdisk/.env.prod（可进仓库的非密钥项）。密钥进 .env.prod.local。
IMAGE_REGISTRY=ghcr.io/OWNER

WEB_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=sister-netdisk
POSTGRES_DB=sister-netdisk_prod

DATABASE_URL=postgresql://sister-netdisk:change-me@postgres:5432/sister-netdisk_prod

NODE_ENV=production
PORT=3000
SWAGGER=0
CORS_ORIGINS=https://www.example.com,https://admin.example.com
BETTER_AUTH_URL=https://api.example.com
WEB_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_WEB_URL=https://www.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ADMIN_API_URL=/api

PANSOU_URL=http://pansou:8888
PANSOU_TIMEOUT_MS=10000
PANSOU_CACHE_TTL_MS=60000
SHARE_CHECK_ENABLED=true
SHARE_CHECK_TIMEOUT_MS=2000
SHARE_CHECK_CONCURRENCY=6
SHARE_CHECK_BUDGET_MS=2500

S3_BUCKET=sister-netdisk
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
NEXT_PUBLIC_S3_PUBLIC_DOMAIN=
