# Railway API 变量清单。复制到控制台，不要把填好的值提交进 git。

NODE_ENV=production
SWAGGER=0

# Postgres 插件注入 DATABASE_URL；能用内网就改成 DATABASE_PRIVATE_URL。
# DATABASE_URL=

# 至少 32 位随机串。生产禁止 db:seed。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.wangpanmei.com
WEB_URL=https://www.wangpanmei.com
ADMIN_URL=https://admin.wangpanmei.com
CORS_ORIGINS=https://www.wangpanmei.com,https://admin.wangpanmei.com

# 换成你的 Pansou 服务名。只走 Railway 内网，不要给 Pansou 配公网域名。
PANSOU_URL=http://pansou.railway.internal:8888
PANSOU_TIMEOUT_MS=10000
PANSOU_CACHE_TTL_MS=60000

# 海外探国内网盘死链可能不准，必要时关掉。
SHARE_CHECK_ENABLED=true
SHARE_CHECK_TIMEOUT_MS=2000
SHARE_CHECK_CONCURRENCY=6
SHARE_CHECK_BUDGET_MS=2500
