{
  "name": "sister-netdisk",
  "version": "0.1.0",
  "private": true,
  "description": "sister-netdisk monorepo — web + Pansou",
  "license": "MIT",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev --filter=@repo/web",
    "dev:web": "turbo dev --filter=@repo/web",
    "build": "turbo build",
    "lint": "biome ci .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "bash scripts/ci-local.sh",
    "pansou:up": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml up -d pansou",
    "pansou:down": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml stop pansou",
    "storage:up": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml --profile storage up -d",
    "storage:down": "docker compose --env-file .env -f infra/docker/docker-compose.dev.yml --profile storage down",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "@biomejs/biome": "2.5.12"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
